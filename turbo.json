{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": [],
      "cache": false
    },
    "@newsdeck/api#test": {
      "dependsOn": ["^build", "@newsdeck/db#test"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": [],
      "cache": false
    },
    "@newsdeck/worker#test": {
      "dependsOn": ["^build", "@newsdeck/api#test"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["E2E_ADMIN_URL", "E2E_WEB_URL", "PLAYWRIGHT_CHROMIUM_EXECUTABLE"]
}
