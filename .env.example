# ---------------------------------------------------------------------------
# Newsdeck local configuration
#
#   cp .env.example .env
#
# `docker compose up` works WITHOUT this file — every variable below has a
# working default baked into docker-compose.yml. Copy it only when you want to
# change something, or when running processes directly on the host.
#
# Every value here is a LOCAL DEVELOPMENT value. None is a secret, and none may
# be reused in a deployed environment.
# ---------------------------------------------------------------------------

# --- Shared ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=newsdeck
POSTGRES_PASSWORD=newsdeck_local_password
POSTGRES_DB=newsdeck
DATABASE_MAX_CONNECTIONS=10

# --- Authentication --------------------------------------------------------
# `local` is the only provider implemented today: it verifies JWTs this
# repository signs itself, so the stack runs with no external identity
# provider. See docs/architecture.md#authentication.
AUTH_PROVIDER=local
AUTH_ISSUER=newsdeck-local
AUTH_AUDIENCE=newsdeck
# Local-only signing key. Never reuse outside local development.
AUTH_LOCAL_SIGNING_KEY=local-development-signing-key-change-me

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# --- Proxy -----------------------------------------------------------------
PROXY_WEB_PORT=8080
PROXY_ADMIN_PORT=8081
# Loopback by default. Set to 0.0.0.0 to reach the stack from another machine.
PROXY_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Host-mode development only (`bun run dev`, migrations and tests run directly
# on the host). Compose does NOT read these: inside the compose network it
# derives DATABASE_URL and REDIS_URL from the service definitions above, so a
# changed password can never leave the two out of step.
#
# These point at the ports docker-compose.dev-ports.yml publishes.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://newsdeck:newsdeck_local_password@localhost:5432/newsdeck
REDIS_URL=redis://localhost:6379

# Used by `bun run test`. Integration tests are skipped when these are unset.
TEST_DATABASE_URL=postgres://newsdeck:newsdeck_local_password@localhost:5432/newsdeck_test
TEST_REDIS_URL=redis://localhost:6379

# Where the Vite dev server forwards `/api` when the proxy is not in the path.
DEV_API_PROXY_TARGET=http://localhost:3001

# Browser origins allowed to call the API cross-origin. Needed only in host
# mode, where web runs on :3000 and the API on :3001. Through the proxy
# everything is same-origin, so compose leaves this empty and CORS stays off.
API_CORS_ORIGINS=http://localhost:3000
